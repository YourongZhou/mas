# To separate your traces from other application
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=math_mas_studio

# Add API keys for connecting to LLM providers, data sources, and other integrations here
# LANGSMITH_API_KEY=lsv2xxx
OPENAI_API_KEY=sk-xxx
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-turbo-latest
# 可选：若终端 curl 能访问 DashScope 但应用报 Connection error，多为环境变量里的代理失效；设为 false 让 Python 直连
# MAS_HTTPS_TRUST_ENV=false
# LLM_REQUEST_TIMEOUT=120